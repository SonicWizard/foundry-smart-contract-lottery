# Copy to .env and fill in. Secrets are 1Password secret references; run commands through
# `op run --env-file=.env` (see mise.toml tasks).
SEPOLIA_RPC_URL=op://your-vault/your-item/your-field
ETHERSCAN_API_KEY=op://your-vault/your-item/your-field

# Address of your Foundry keystore account. It owns the subscription below and holds its LINK; scripts broadcast from
# it on Sepolia.
SEPOLIA_ACCOUNT=

# Public on-chain value; owned by SEPOLIA_ACCOUNT. Set it from the output of `mise run sub:create:sepolia`.
SEPOLIA_SUBSCRIPTION_ID=

# Optional: the key `mise run cre:broadcast:sepolia` sends the CRE report from (needs Sepolia ETH). Keep it in
# 1Password; dry runs don't need it.
# CRE_ETH_PRIVATE_KEY=op://your-vault/your-item/your-field
